# 统一按 LF 存储，检出时按平台转换，避免 Windows/macOS 换行符互相打架
* text=auto eol=lf

# 文档与脚本：文本，LF
*.md      text eol=lf
*.txt     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf

# 二进制：不做任何转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.zip     binary
*.bin     binary
*.elf     binary
*.hex     binary
*.xlsx    binary
*.pptx    binary
*.docx    binary
